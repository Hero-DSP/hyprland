[Unit]
Description=Wayland clipboard manager with support for multimedia
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland

[Service]
Type=simple
ExecStart=/bin/sh -c '/usr/bin/wl-paste --type text --watch cliphist store & /usr/bin/wl-paste --type image --watch cliphist store & wait'
ExecStop=/usr/bin/cliphist wipe
Restart=on-failure

[Install]
WantedBy=graphical-session.target

